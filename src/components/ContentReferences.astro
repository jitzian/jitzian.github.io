---
interface Reference {
    name: string;
    role: string;
    phone: string;
    email: string;
}

const references: Reference[] = [
    {
        name: 'Bidisha Biswas',
        role: 'Sr. iOS Developer / Sr. Software Engineer',
        phone: '+1 (402) 800-6567',
        email: ''
    },
    {
        name: 'Brandon Hidalgo',
        role: 'Sr. Android Developer / Sr. Software Engineer',
        phone: '+1 (570) 982-9828',
        email: 'bhidalgo1999@gmail.com'
    },
    {
        name: 'Andrew Edwards',
        role: 'Sr. iOS Developer / Sr. Software Engineer',
        phone: '+1 (251) 263-3579',
        email: 'Andrewangeta@gmail.com'
    },
    {
        name: 'Cheryl Sedota',
        role: 'Software Architect / Sr. Android Engineer',
        phone: '+1 (512) 797-1478',
        email: 'cherylsedota@gmail.com'
    },
    {
        name: 'James Malak',
        role: 'Sr. iOS Engineer',
        phone: '+1 (234) 716-2658',
        email: 'jim.malak@beryle-lee.com'
    }
];
---

<div class="prose prose-invert max-w-none">
    <h2 class="text-2xl font-bold mb-6 text-primary">References</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {references.map((ref) => (
            <div class="border border-gray-700 rounded-lg p-4 bg-gray-900">
                <h3 class="text-lg font-bold text-gray-100">{ref.name}</h3>
                <p class="text-sm text-primary mb-2">{ref.role}</p>
                
                <div class="text-gray-400 text-sm space-y-1">
                    {ref.phone && (
                        <p class="flex items-center">
                            <span class="mr-2">📱</span>
                            {ref.phone}
                        </p>
                    )}
                    {ref.email && (
                        <p class="flex items-center">
                            <span class="mr-2">📧</span>
                            <a href={`mailto:${ref.email}`} class="hover:text-primary transition-colors">
                                {ref.email}
                            </a>
                        </p>
                    )}
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .prose {
        color: #e5e7eb;
    }
</style>
