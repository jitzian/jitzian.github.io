        company: 'Photon Infotech Inc.',
        client: 'Alliance Data Card Services',
        role: 'Tech Lead / Android Developer',
        period: 'February 2017 - February 2019',
        technologies: 'Android Jetpack, Android SDK, MVVM/MVI, Dagger, Room DB, Kotlin coroutines',
