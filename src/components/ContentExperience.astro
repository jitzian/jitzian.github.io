const education = {
    degree: 'Computer Systems Engineer',
    institution: 'National Polytechnic Institute',
    period: '2002 - 2007',
    link: 'https://www.escom.ipn.mx/'
};
---

<div class="prose prose-invert max-w-none">
    <h2 class="text-2xl font-bold mb-6 text-primary">Work Experience</h2>
    
    <div class="space-y-8">
        {experiences.map((exp, index) => (
            <div class="border-l-2 border-primary pl-4 pb-6">
                <div class="mb-2">
                    <h3 class="text-xl font-bold text-gray-100">{exp.role}</h3>
                    <p class="text-lg text-primary">
                        {exp.company}
                        {exp.client && <span class="text-gray-400"> • Client: {exp.client}</span>}
                    </p>
                    <p class="text-sm text-gray-400">{exp.period}</p>
                    {exp.link && (
                        <a 
                            href={exp.link} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="text-xs text-blue-400 hover:underline"
                        >
                            View App →
                        </a>
                    )}
                </div>
                
                <p class="text-sm text-gray-500 mb-3">
                    <strong>Technologies:</strong> {exp.technologies}
                </p>
                
                <ul class="space-y-2 text-sm text-gray-300">
                    {exp.achievements.map(achievement => (
                        <li class="flex items-start">
                            <span class="text-primary mr-2">▹</span>
                            <span>{achievement}</span>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>

    <div class="mt-12 pt-8 border-t border-gray-600">
        <h2 class="text-2xl font-bold mb-6 text-primary">Education</h2>
        <div class="border-l-2 border-primary pl-4">
            <h3 class="text-xl font-bold text-gray-100">{education.degree}</h3>
            <p class="text-lg text-gray-300">{education.institution}</p>
            <p class="text-sm text-gray-400">{education.period}</p>
            <a 
                href={education.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-xs text-blue-400 hover:underline"
            >
                Visit Institution →
            </a>
        </div>
    </div>
</div>

<style>
    .prose {
        color: #e5e7eb;
    }
    
    .prose h2 {
        margin-top: 0;
    }
    
    .prose ul {
        list-style: none;
        padding-left: 0;
    }
</style>
